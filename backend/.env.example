# Database (Supabase/Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# Frontend URL (for CORS & Socket). Production: https://your-app.vercel.app
# Multiple: https://app.vercel.app,https://app-git-main.vercel.app
FRONTEND_URL="http://localhost:3000"

# PayPal (Sandbox for dev, Live for prod)
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_LIVE="false"

# Email (optional - for booking confirmations)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="A One Tarot <noreply@aonetarot.com>"

# Server
PORT=4000
